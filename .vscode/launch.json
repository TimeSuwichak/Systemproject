{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Launch Chrome",
            "request": "launch",
            "type": "chrome",
            "url": "http://localhost:5075",
            "webRoot": "${workspaceFolder}"
        },

        {
            "name": "Attach to Chrome",
            "port": 9222,
            "request": "attach",
            "type": "chrome",
            "webRoot": "${workspaceFolder}"
        },
        {
            "name": "C#: Launch Startup Project",
            "type": "dotnet",
            "request": "launch",
            "__csdevkitLaunchStartupProject": true
        },
        {
            "name": "C#: AppProject [Default Configuration]",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/AppProject/AppProject.csproj"
        },
        {
            "name": "C#: AppProject [http]",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/AppProject/AppProject.csproj",
            "launchProfileName": "http",
            "launchConfigurationId": "http"
        },
        {
            "name": "C#: AppProject [https]",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${workspaceFolder}/AppProject/AppProject.csproj",
            "launchProfileName": "https",
            "launchConfigurationId": "https"
        },
        {
            "name": "C#: Debug Active File",
            "type": "dotnet",
            "request": "launch",
            "projectPath": "${file}"
        }
    ]
}