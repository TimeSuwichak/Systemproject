        </section>

        <!-- ==================== ADMIN & FINANCE: AUDIT LOGS ==================== -->
        <!-- 🔗 [จุดเชื่อมต่อ หน้าบ้าน <-> หลังบ้าน] หน้าบันทึกประวัติการทำงาน (Audit Trail สำหรับ Admin และ Finance)
             HTTP Method & Route: GET /api/audit-logs?role={all|Admin|Finance} -> Controllers/AuditLogsController.cs
             การผูกข้อมูล: loadAuditLogs() ใน site.js ดึงรายการ Log และเติมลง #auditLogRows เมื่อเปิดหน้าหรือกดปุ่ม [data-audit-filter] -->
        <section class="view-panel" id="view-audit-logs">
            <div class="page-heading">
                <div>
                    <p class="eyebrow"><span class="eyebrow-line"></span> SYSTEM AUDIT TRAIL</p>
                    <h1>บันทึกประวัติการทำงาน (Audit Log)</h1>
                    <p class="intro">ตรวจสอบประวัติการอนุมัติ ปฏิเสธ ระงับบัญชี ตรวจสลิป ปล่อยเงิน คืนเงิน และแก้กติกาทั้งหมด</p>
                </div>
                <!-- ปุ่มตัวกรองบทบาทผู้ดำเนินการ ส่งค่า roleFilter ไปยัง query string ของ GET /api/audit-logs -->
                <div class="sort-controls">
                    <button class="sort-button active" type="button" data-audit-filter="all">ทั้งหมด</button>
                    <button class="sort-button" type="button" data-audit-filter="Admin">Admin</button>
                    <button class="sort-button" type="button" data-audit-filter="Finance">Finance</button>
                </div>
            </div>
            <div class="table-wrap">
                <table class="data-table">
                    <thead><tr><th>วันเวลา</th><th>ผู้ดำเนินการ</th><th>บทบาท</th><th>การกระทำ</th><th>เป้าหมาย</th><th>รายละเอียด</th></tr></thead>
                    <tbody id="auditLogRows"><tr class="empty-row"><td colspan="6">ยังไม่มีประวัติการทำงาน</td></tr></tbody>
                </table>
            </div>
        </section>

        <!-- ส่วนท้ายหน้าเว็บ (Footer) แสดงชื่อระบบและลิงก์กลับหน้าประมูลวันนี้ -->
        <footer class="page-footer">
            <span>© 2569 ของเก่าเล่าเรื่อง</span>
            <span>ระบบประมูลของสะสมครบวงจร · SQLite + ASP.NET Core</span>
            <a href="#" data-view-link="today">กลับหน้าหลัก ↑</a>
        </footer>
    </main>
</div>

<!-- ==================== MODAL DIALOGS & TOASTS ==================== -->
<!-- 🔗 [จุดเชื่อมต่อ หน้าบ้าน <-> หลังบ้าน] กล่องโต้ตอบรายละเอียดสินค้าและฟอร์มเสนอราคา (Bid)
     HTTP Method & Route:
       - GET /api/auctions/{id} (ฟังก์ชัน openProduct() เติมรายละเอียดสินค้าและประวัติการบิดลง #dialogContent) -> Controllers/AuctionsController.cs
       - POST /api/auctions/{id}/bid (ส่ง JSON { amount } เมื่อกด submit ฟอร์ม #bidForm ภายในกล่องนี้) -> Controllers/AuctionsController.cs
       - POST /api/chat/start (ปุ่ม "แชทกับผู้ขาย" ภายในกล่องนี้) -> Controllers/ChatController.cs -->
<!-- Product Detail & Bid Dialog -->
<dialog class="auction-dialog" id="auctionDialog">
    <form method="dialog"><button class="dialog-close" aria-label="ปิด">×</button></form>
    <div id="dialogContent"></div>
</dialog>

<!-- 🔗 [จุดเชื่อมต่อ หน้าบ้าน <-> หลังบ้าน] กล่องโต้ตอบยืนยันตัวตน (เข้าสู่ระบบ / สมัครสมาชิก / ลืมรหัสผ่าน)
     HTTP Method & Route (ทั้งหมดอยู่ที่ Controllers/AuthController.cs):
       - POST /api/auth/login (ฟอร์ม #loginForm หรือปุ่มทดลองบัญชี #demoAccountsGrid -> รับ Auth Cookie)
       - GET /api/auth/demo-accounts (โหลดบัญชีทดสอบในโหมด Development ลง #demoAccountsGrid)
       - POST /api/auth/forgot-password (ฟอร์ม #forgotPasswordForm -> ขอรหัสรีเซ็ต 6 หลัก)
       - POST /api/auth/reset-password (ฟอร์ม #resetPasswordForm -> ยืนยันตั้งรหัสผ่านใหม่)
       - POST /api/auth/register (ฟอร์ม #registerForm -> สมัคร Buyer หรือ Seller และรับ Auth Cookie) -->
<!-- Auth Login / Register Dialog -->
<dialog class="auction-dialog auth-dialog" id="authDialog">
    <form method="dialog"><button class="dialog-close" aria-label="ปิด">×</button></form>
    <div class="auth-modal-body">
        <!-- แถบแท็บสลับระหว่าง "เข้าสู่ระบบ" และ "สมัครสมาชิก" -->
        <div class="auth-tabs">
            <button type="button" class="auth-tab active" data-auth-tab="login">เข้าสู่ระบบ</button>
            <button type="button" class="auth-tab" data-auth-tab="register">สมัครสมาชิก</button>
        </div>

        <!-- แท็บ 1: เข้าสู่ระบบ (#loginForm) + ปุ่มทดลอง 4 บทบาทในโหมด Development -->
        <div id="authTabLogin">
            <h2 class="auth-title">เข้าสู่ระบบ ของเก่าเล่าเรื่อง</h2>
            <p class="auth-subtitle">รองรับ 4 บทบาท: ผู้ประมูล, ผู้ขาย, แอดมิน และฝ่ายการเงิน</p>
            <form id="loginForm" class="auth-form">
                <label class="field-label">อีเมล <span>*</span><input name="email" type="email" required placeholder="name@example.com"></label>
                <label class="field-label">รหัสผ่าน <span>*</span><input name="password" type="password" required placeholder="••••••"></label>
                <button class="button button-primary full-width" type="submit">เข้าสู่ระบบ</button>
            </form>
            <div style="text-align:right;margin-top:8px;">
                <button type="button" class="text-button" data-auth-tab="forgot">ลืมรหัสผ่าน?</button>
            </div>
            <!-- ส่วนบัญชีทดสอบด่วน: site.js จะซ่อนส่วนนี้หาก GET /api/auth/demo-accounts คืนค่าว่าง (เช่นบน Production) -->
            <div id="demoAccountsSection">
                <div class="demo-divider"><span>หรือทดลองเข้าสู่ระบบด่วน (Development เท่านั้น · รหัสผ่าน 123456)</span></div>
                <div class="demo-accounts-grid" id="demoAccountsGrid"></div>
            </div>
        </div>

        <!-- แท็บ 2: ลืมรหัสผ่านและตั้งรหัสผ่านใหม่ด้วยรหัส 6 หลัก -->
        <div id="authTabForgot" class="hidden">
            <h2 class="auth-title">ลืมรหัสผ่าน / ตั้งรหัสผ่านใหม่</h2>
            <p class="auth-subtitle">กรอกอีเมลเพื่อรับรหัสรีเซ็ต 6 หลัก (ใช้งานได้ภายใน 15 นาที)</p>
            <form id="forgotPasswordForm" class="auth-form">
                <label class="field-label">อีเมลบัญชีของคุณ <span>*</span><input name="email" type="email" required placeholder="name@example.com"></label>
                <button class="button button-secondary full-width" type="submit">ขอรหัสรีเซ็ต 6 หลัก</button>
            </form>
            <!-- แสดงรหัสรีเซ็ตอัตโนมัติในโหมด Development (#forgotDevNotice) -->
            <div id="forgotDevNotice" class="info-banner hidden" style="margin-top:12px;"></div>
            <form id="resetPasswordForm" class="auth-form" style="margin-top:14px;">
                <label class="field-label">อีเมล <span>*</span><input name="email" type="email" required placeholder="name@example.com"></label>
                <div class="field-row">
                    <label class="field-label">รหัสรีเซ็ต 6 หลัก <span>*</span><input name="resetToken" required maxlength="10" placeholder="123456"></label>
                    <label class="field-label">รหัสผ่านใหม่ (6+ ตัว) <span>*</span><input name="newPassword" type="password" minlength="6" required></label>
                </div>
                <button class="button button-primary full-width" type="submit">ยืนยันตั้งรหัสผ่านใหม่</button>
            </form>
            <div style="text-align:center;margin-top:10px;">
                <button type="button" class="text-button" data-auth-tab="login">← กลับไปหน้าเข้าสู่ระบบ</button>
            </div>
        </div>

        <!-- แท็บ 3: สมัครสมาชิกใหม่ (เลือกบทบาท Buyer หรือ Seller) -->
        <div id="authTabRegister" class="hidden">
            <h2 class="auth-title">สร้างบัญชีใหม่</h2>
            <p class="auth-subtitle">เลือกสมัครเป็นผู้ประมูล (ใช้งานได้ทันที) หรือผู้ขาย (รอแอดมินอนุมัติ)</p>
            <form id="registerForm" class="auth-form">
                <label class="field-label">ประเภทบัญชี <span>*</span>
                    <!-- เมื่อเปลี่ยนเป็น Seller, site.js จะแสดง #regSellerFields และบังคับกรอกข้อมูลร้าน -->
                    <select name="role" id="regRoleSelect">
                        <option value="Buyer">ผู้ประมูล (Buyer) — ประมูลและซื้อของสะสม</option>
                        <option value="Seller">ผู้ขาย (Seller) — นำของมาประมูล (รอ Admin อนุมัติ)</option>
                    </select>
                </label>
                <label class="field-label">ชื่อที่แสดง <span>*</span><input name="displayName" required maxlength="80" placeholder="เช่น คุณสมหญิง"></label>
                <div class="field-row">
                    <label class="field-label">อีเมล <span>*</span><input name="email" type="email" required placeholder="you@example.com"></label>
                    <label class="field-label">รหัสผ่าน (6+ ตัวอักษร) <span>*</span><input name="password" type="password" minlength="6" required></label>
                </div>
                <!-- ฟิลด์เพิ่มเติมเฉพาะผู้สมัครเป็นผู้ขาย (ซ่อนไว้เมื่อเลือก Buyer) -->
                <div id="regSellerFields" class="hidden">
                    <label class="field-label">ชื่อร้านค้า <span>*</span><input name="shopName" maxlength="100" placeholder="เช่น เรือนสะสมโบราณ"></label>
                    <div class="field-row">
                        <label class="field-label">เบอร์โทรศัพท์ <span>*</span><input name="phone" maxlength="30" placeholder="08x-xxx-xxxx"></label>
                        <label class="field-label">บัญชีรับเงิน <span>*</span><input name="bankAccount" maxlength="120" placeholder="ธนาคาร + เลขบัญชี"></label>
                    </div>
                    <label class="field-label">แนะนำร้าน <textarea name="sellerBio" rows="2" placeholder="ประเภทสินค้าที่จะนำมาประมูล"></textarea></label>
                </div>
                <button class="button button-primary full-width" type="submit">สมัครสมาชิก</button>
            </form>
        </div>
    </div>
</dialog>

<!-- 🔗 [จุดเชื่อมต่อ หน้าบ้าน <-> หลังบ้าน] กล่องโต้ตอบอเนกประสงค์ (#actionDialog)
     การทำงาน: wwwroot/js/site.js สร้าง HTML ฟอร์ม/รายละเอียดแบบไดนามิกลงใน #actionDialogContent สำหรับงานต่างๆ เช่น
       - ชำระเงิน & อัปโหลดสลิป (POST /api/buyer/orders/{id}/pay) และดูภาพสลิปขนาดใหญ่
       - เปลี่ยนรหัสผ่าน (POST /api/auth/change-password)
       - แก้ไขสินค้า (PUT /api/seller/listings/{id}), ดูประวัติบิด, กำหนดนัดรับ (POST /api/seller/orders/{id}/meetup)
       - แจ้งข้อพิพาท (POST /api/chat/conversations/{id}/dispute) และแอดมินตรวจแชทข้อพิพาท (GET/POST /api/admin/disputes/{id}/*)
       - ระบุเหตุผลการปฏิเสธ/ระงับบัญชี/ปล่อยเงิน/คืนเงิน (Admin & Finance APIs) -->
<!-- Generic Action / Detail Dialog (Reject reason, Suspend, Meetup, Dispute Chat, Bid History) -->
<dialog class="auction-dialog action-dialog" id="actionDialog">
    <form method="dialog"><button class="dialog-close" aria-label="ปิด">×</button></form>
    <div id="actionDialogContent" class="action-dialog-body"></div>
</dialog>

<!-- พื้นที่แสดงข้อความแจ้งเตือนแบบลอยมุมขวาล่าง (Toast Notifications) ควบคุมโดย showToast() ใน site.js -->
<div class="toast-region" id="toastRegion" aria-live="polite"></div>

@* 🔗 [จุดเชื่อมต่อ หน้าบ้าน <-> หลังบ้าน]
   HTTP Method & Route: GET /js/site.js?v=... (เสิร์ฟไฟล์ Static จาก wwwroot/js/site.js)
   การทำงาน: @section Scripts จะถูกนำไปแทรกที่ @await RenderSectionAsync("Scripts") ท้าย <body> ใน Views/Shared/_Layout.cshtml
   โดย site.js คือสคริปต์ศูนย์กลางฝั่งหน้าบ้านที่เรียก fetch() ไปยัง REST API ทั้งหมด (/api/*) *@
@section Scripts {
    <script src="~/js/site.js" asp-append-version="true"></script>
}
