@* ============================================================================
   ไฟล์: Views/Home/Index.cshtml
   บทบาท: ฝั่งหน้าบ้าน (Frontend — Main Single-Page Application Razor View)
   หน้าที่โดยรวม: โครงสร้าง HTML หลักของระบบประมูล "ของเก่าเล่าเรื่อง" ทั้งหมดในไฟล์เดียว
                 แบ่งเป็น Sidebar, Topbar, 16 หน้าจอย่อย (.view-panel) สำหรับ 4 บทบาท
                 (Buyer, Seller, Admin, Finance) และกล่องโต้ตอบ (Modal Dialogs)
                 โดยให้ wwwroot/js/site.js เป็นตัวสลับหน้าจอและสื่อสารกับ REST API ทั้งหมด
   การเชื่อมต่อ:
     - ถูกเรนเดอร์จากฝั่งหลังบ้าน Controllers/HomeController.cs -> Action Index() (GET / หรือ GET /Home/Index)
     - แทรกลงใน @RenderBody() ของ Views/Shared/_Layout.cshtml
     - ตกแต่งด้วย wwwroot/css/site.css และควบคุมตรรกะ/เรียก API ด้วย wwwroot/js/site.js
   ============================================================================ *@
@* 🔗 [จุดเชื่อมต่อ หน้าบ้าน <-> หลังบ้าน]
   HTTP Method & Route: GET / (หรือ GET /Home/Index) -> HomeController.Index()
   ข้อมูลที่ส่งกลับ: HTML View นี้ถูกห่อด้วย Views/Shared/_Layout.cshtml และโหลด wwwroot/js/site.js เพื่อเริ่มต้นระบบ *@
@{
    // กำหนดชื่อหน้าเว็บส่งไปยังแท็ก <title> ใน Views/Shared/_Layout.cshtml
    ViewData["Title"] = "ของเก่าเล่าเรื่อง — ตลาดประมูลของสะสม";
}

<!-- โครงสร้างหลักของแอป (App Shell): ประกอบด้วยแถบเมนูซ้าย (Sidebar) + พื้นที่เนื้อหาหลัก (Main Content) -->
<div class="app-shell">
    <!-- ฉากหลังมืดสำหรับปิดเมนู Sidebar บนหน้าจอมือถือ (ควบคุมด้วย closeMobileDrawer ใน site.js) -->
    <div class="sidebar-backdrop hidden" id="sidebarBackdrop"></div>

    <!-- แถบเมนูนำทางด้านซ้าย (Sidebar) -->
    <aside class="sidebar" id="sidebar">
        <!-- โลโก้และชื่อแบรนด์ กดเพื่อสลับกลับไปหน้า "ประมูลวันนี้" (view-today) -->
        <a class="brand" href="#" data-view-link="today" aria-label="ของเก่าเล่าเรื่อง หน้าแรก">
            <span class="brand-mark">ก</span>
            <span><strong>ของเก่าเล่าเรื่อง</strong><small>OLD THINGS, NEW STORIES</small></span>
        </a>

        <!-- 🔗 [จุดเชื่อมต่อ หน้าบ้าน <-> หลังบ้าน]
             HTTP Method & Route: GET /api/auth/me -> Controllers/AuthController.cs
             การผูกข้อมูล: ฟังก์ชัน refreshSession() และ buildSidebar() ใน wwwroot/js/site.js
             จะอ่านบทบาทผู้ใช้ (Buyer / Seller / Admin / Finance) จาก Auth Cookie แล้วสร้างรายการเมนูภายใน #sidebarNavContainer ใหม่ทั้งหมด -->
        <div id="sidebarNavContainer" class="sidebar-nav-container">
            <div class="sidebar-label">เมนูหลัก</div>
            <nav class="side-nav" aria-label="เมนูหลัก">
                <button class="nav-item active" data-view-link="today"><span class="nav-icon">⌂</span> ประมูลวันนี้ <span class="nav-count" id="navLiveCount">0</span></button>
            </nav>
        </div>

        <!-- ส่วนท้ายของ Sidebar: กล่องข้อความสร้างความมั่นใจเรื่องนัดรับ + ปุ่มโปรไฟล์/เข้าสู่ระบบ -->
        <div class="sidebar-bottom">
            <div class="meetup-note">
                <span class="meetup-icon">⌖</span>
                <strong>นัดรับอย่างสบายใจ</strong>
                <p>ตกลงสถานที่และเวลารับสินค้ากับผู้ขายโดยตรง ระบบคุ้มครองเงินจนกว่าจะยืนยันรับของ</p>
            </div>
            <!-- พื้นที่โปรไฟล์ผู้ใช้ด้านล่าง Sidebar: site.js (buildSidebar) จะอัปเดตชื่อผู้ใช้และบทบาท หรือปุ่มเปิด #authDialog -->
            <div id="sidebarAuthArea">
                <button class="profile-button" id="openAuthBtn" type="button">
                    <span class="avatar">?</span>
                    <span><strong>เข้าสู่ระบบ</strong><small>เลือกบทบาทหรือสมัครสมาชิก</small></span>
                    <span class="more">→</span>
                </button>
            </div>
        </div>
    </aside>

    <!-- พื้นที่เนื้อหาหลักทางขวาของ Sidebar -->
    <main class="main-content">
        <!-- แถบด้านบน (Topbar): ปุ่มเมนูมือถือ, Breadcrumb, ช่องค้นหา, กระดิ่งแจ้งเตือน และปุ่มบัญชีผู้ใช้ -->
        <header class="topbar">
            <div class="topbar-left">
                <!-- ปุ่มเปิด/ปิด Sidebar บนหน้าจอแคบ (< 960px) ผูก event ใน site.js -->
                <button class="icon-button mobile-menu-btn" id="mobileMenuBtn" type="button" aria-label="เปิดเมนู">☰</button>
                <div class="mobile-brand"><span class="brand-mark">ก</span><strong>ของเก่าเล่าเรื่อง</strong></div>
                <!-- เส้นทางหน้าปัจจุบัน (#pageCrumb อัปเดตโดย switchView() ใน site.js) -->
                <div class="breadcrumbs"><span>หน้าหลัก</span><span class="crumb-sep">/</span><strong id="pageCrumb">ประมูลวันนี้</strong></div>
            </div>
            <div class="top-actions">
                <!-- 🔗 [จุดเชื่อมต่อ หน้าบ้าน <-> หลังบ้าน]
                     HTTP Method & Route: GET /api/auctions?search={คำค้น}&categoryId=...&sort=... -> Controllers/AuctionsController.cs
                     การผูกข้อมูล: site.js ฟังเหตุการณ์ input บน #searchInput (หน่วงเวลา 220ms) แล้วเรียก loadAuctions() ดึงสินค้าที่ตรงคำค้น -->
                <label class="search-box" id="globalSearchBox">
                    <span>⌕</span>
                    <input id="searchInput" type="search" placeholder="ค้นหาของสะสม..." aria-label="ค้นหาของสะสม">
                </label>

                <!-- 🔗 [จุดเชื่อมต่อ หน้าบ้าน <-> หลังบ้าน]
                     HTTP Method & Route:
                       - GET /api/notifications/summary (Polling ทุก 5 วินาทีใน pollNotifications()) -> Controllers/NotificationsController.cs
                       - POST /api/notifications/read-all (เมื่อกด #markAllReadBtn) -> Controllers/NotificationsController.cs
                       - POST /api/notifications/{id}/read (เมื่อคลิกรายการแจ้งเตือนใน #notifDropdownList) -> Controllers/NotificationsController.cs
                     ข้อมูลที่รับ: JSON สรุปจำนวนข้อความ/แจ้งเตือนที่ยังไม่อ่าน (#notifBadge) และรายการแจ้งเตือน (#notifDropdownList) -->
                <div class="notif-wrapper hidden" id="notifWrapper">
                    <button class="icon-button notif-bell-btn" id="notifBellBtn" type="button" aria-label="การแจ้งเตือน" title="การแจ้งเตือนข้อความและกิจกรรม">
                        <span>🔔</span>
                        <span class="notif-badge hidden" id="notifBadge">0</span>
                    </button>
                    <div class="notif-dropdown hidden" id="notifDropdown">
                        <div class="notif-dropdown-header">
                            <strong>การแจ้งเตือน</strong>
                            <button type="button" class="text-button" id="markAllReadBtn">อ่านทั้งหมดแล้ว</button>
                        </div>
                        <div class="notif-dropdown-list" id="notifDropdownList">
                            <div class="notif-empty">ไม่มีการแจ้งเตือนใหม่</div>
                        </div>
                    </div>
                </div>

                <!-- 🔗 [จุดเชื่อมต่อ หน้าบ้าน <-> หลังบ้าน]
                     HTTP Method & Route:
                       - POST /api/auth/logout (ปุ่ม #logoutBtn ที่สร้างโดย buildSidebar()) -> Controllers/AuthController.cs
                       - POST /api/auth/change-password (ปุ่มเปลี่ยนรหัสผ่านเปิด Modal #actionDialog) -> Controllers/AuthController.cs
                     การทำงาน: แสดงปุ่มเข้าสู่ระบบเมื่อยังไม่ล็อกอิน หรือแสดง Role Badge + ปุ่มเปลี่ยนรหัส/สลับบัญชี/ออกจากระบบ -->
                <div class="topbar-user" id="topbarUserArea">
                    <button class="button button-primary" id="topLoginBtn" type="button">เข้าสู่ระบบ</button>
                </div>
            </div>
        </header>

        <!-- ==================== PUBLIC / BUYER: TODAY ==================== -->
        <!-- 🔗 [จุดเชื่อมต่อ หน้าบ้าน <-> หลังบ้าน] หน้าประมูลวันนี้ (แสดงเป็นหน้าแรก .active)
             HTTP Method & Route:
               - GET /api/auctions?categoryId=...&search=...&sort=... -> Controllers/AuctionsController.cs (GetAuctions)
               - GET /api/auctions/{id} (เมื่อคลิกการ์ดสินค้า [data-detail]) -> Controllers/AuctionsController.cs (เปิด #auctionDialog)
               - POST /api/auctions/{id}/save (เมื่อกดปุ่มหัวใจ [data-save]) -> Controllers/AuctionsController.cs (ToggleSave)
             การผูกข้อมูล: ฟังก์ชัน loadAuctions() ใน wwwroot/js/site.js เติมข้อมูลลง #heroPromoText, #discountHintText, #categoryRow, #productGrid, #liveCount -->
        <section class="view-panel active" id="view-today">
            <div class="today-heading">
                <div>
                    <p class="eyebrow"><span class="eyebrow-line"></span> ตลาดของสะสมประจำวัน</p>
                    <h1>ของดีวันนี้ <span class="heading-period">คัดมาให้คุณ</span></h1>
                    <p class="intro">ทุกชิ้นมีเรื่องราว — เลือกชิ้นที่ใช่ แล้วร่วมประมูลไปด้วยกัน</p>
                </div>
                <!-- การ์ดแสดงวันที่ปัจจุบัน (#todayDate ถูกเติมข้อความวันที่ภาษาไทยตอนเปิดเว็บใน site.js) -->
                <div class="date-card">
                    <span class="date-icon">▦</span>
                    <span><small>วันประมูล</small><strong id="todayDate"></strong></span>
                </div>
            </div>

            <!-- แบนเนอร์โปรโมตด้านบน (Hero Banner) พร้อมภาพตกแต่งด้วย CSS (.hero-art) -->
            <div class="hero-banner">
                <div class="hero-copy">
                    <span class="hero-kicker">THE DAILY FINDS · คัดสรรประจำวัน</span>
                    <h2>ของเก่าที่มีเสน่ห์<br>กำลังรอเจ้าของคนใหม่</h2>
                    <!-- #heroPromoText ถูกอัปเดตเปอร์เซ็นต์ส่วนลดหมวดเดียวกันจริงจาก GlobalSettings ของหลังบ้าน -->
                    <p id="heroPromoText">ชิ้นงานหายากจากนักสะสมทั่วไทย นัดรับได้จริง ทุกการประมูลโปร่งใส พร้อมส่วนลดซื้อหมวดเดียวกัน</p>
                    <div class="hero-actions">
                        <button class="button button-light" type="button" data-scroll="auctionGrid">เลือกดูของวันนี้ <span>→</span></button>
                        <button class="button button-outline-light" type="button" id="heroAuthBtn">เข้าสู่ระบบ / ทดลอง 4 บทบาท</button>
                    </div>
                </div>
                <!-- งานศิลปะตกแต่งฝั่งขวาของ Hero (สร้างด้วย CSS Pure Shapes ใน site.css) -->
                <div class="hero-art" aria-hidden="true">
                    <div class="sun-disc"></div>
                    <div class="hero-vase"></div>
                    <span class="hero-stamp">VINTAGE<br>FINDS</span>
                    <span class="hero-leaf">✳</span>
                </div>
            </div>

            <!-- ส่วนเลือกกรองตามหมวดหมู่สินค้า (data-category="0" คือดูทั้งหมด) -->
            <div class="section-heading category-heading">
                <div><h2>เลือกตามหมวดหมู่</h2><p id="discountHintText">ซื้อสินค้าหมวดเดียวกันรับส่วนลดพิเศษอัตโนมัติตอนชำระเงิน</p></div>
                <button class="text-button" type="button" data-category="0">ดูทั้งหมด <span>→</span></button>
            </div>
            <!-- คอนเทนเนอร์ปุ่มชิปหมวดหมู่ เติมโดย loadAuctions() จาก data.categories -->
            <div class="category-row" id="categoryRow" aria-label="เลือกหมวดหมู่"></div>

            <!-- หัวข้อรายการสินค้าที่กำลังเปิดประมูล พร้อมปุ่มเรียงลำดับและปุ่มสลับมุมมองกริด/รายการ -->
            <div class="section-heading listing-heading" id="auctionGrid">
                <div>
                    <h2>กำลังเปิดประมูล <span class="live-count" id="liveCount">00</span></h2>
                    <p>ร่วมประมูลก่อนหมดเวลา แล้วเป็นเจ้าของชิ้นพิเศษ</p>
                </div>
                <div class="sort-controls">
                    <!-- ปุ่มเรียงลำดับส่ง query string sort=ending หรือ sort=newest ไปยัง GET /api/auctions -->
                    <button class="sort-button active" type="button" data-sort="ending">ใกล้หมดเวลา</button>
                    <button class="sort-button" type="button" data-sort="newest">มาใหม่</button>
                    <!-- สลับคลาส .list-view บน #productGrid -->
                    <button class="view-toggle" id="viewToggleBtn" type="button" aria-label="สลับมุมมองกริดหรือรายการ" title="สลับมุมมอง">▦</button>
                </div>
            </div>
            <!-- ตารางการ์ดสินค้าประมูล เติม HTML การ์ดโดย loadAuctions() ใน site.js พร้อมตัวนับถอยหลัง real-time -->
            <div class="product-grid" id="productGrid"></div>
            <div class="empty-state hidden" id="emptyState">ไม่พบสินค้าที่ตรงกับการค้นหา ลองเปลี่ยนคำค้นหรือหมวดหมู่ดูนะ</div>

            <!-- แถบอธิบายขั้นตอนการประมูล 3 ขั้นตอนสำหรับผู้ใช้งานใหม่ -->
            <div class="how-it-works">
                <div class="how-title"><span>เริ่มสะสมได้ง่ายๆ</span><strong>ประมูลอย่างมั่นใจใน 3 ขั้นตอน</strong></div>
                <div class="how-step"><span>01</span><div><strong>เลือกของที่ชอบ</strong><small>ดูรายละเอียดและประวัติราคา</small></div></div>
                <div class="how-step"><span>02</span><div><strong>เสนอราคา</strong><small>แข่งขันแบบโปร่งใสตามขั้นต่ำ</small></div></div>
                <div class="how-step"><span>03</span><div><strong>ชำระเงิน & นัดรับ</strong><small>ระบบดูแลเงินจนกว่าจะยืนยันรับของ</small></div></div>
            </div>
        </section>

        <!-- ==================== BUYER: SAVED & BID HISTORY ==================== -->
        <!-- 🔗 [จุดเชื่อมต่อ หน้าบ้าน <-> หลังบ้าน] หน้ารายการที่บันทึกไว้และประวัติการเสนอราคาของผู้ซื้อ
             HTTP Method & Route:
               - GET /api/buyer/dashboard -> Controllers/AuctionsController.cs (GetBuyerDashboard)
               - POST /api/auctions/{id}/save (ปุ่มหัวใจใน #savedGrid) -> Controllers/AuctionsController.cs
               - GET /api/auctions/{id} (ลิงก์ชื่อสินค้าใน #bidHistoryRows / #savedGrid) -> Controllers/AuctionsController.cs
             การผูกข้อมูล: loadBuyerDashboard() ใน site.js นำ data.saved และ data.bidHistory มาแสดง -->
        <section class="view-panel" id="view-mybids">
            <div class="page-heading">
                <p class="eyebrow"><span class="eyebrow-line"></span> YOUR COLLECTION</p>
                <h1>รายการที่สนใจ & ประวัติการเสนอราคา</h1>
                <p class="intro">ของสะสมที่คุณบันทึกไว้และสถานะการเสนอราคาล่าสุดของคุณ</p>
            </div>
            <div class="section-heading"><div><h2>รายการที่บันทึกไว้</h2><p>กดรูปหัวใจเพื่อบันทึกหรือนำออก</p></div></div>
            <!-- การ์ดสินค้าที่ผู้ซื้อกดหัวใจบันทึกไว้ -->
            <div class="product-grid" id="savedGrid"></div>
            <div class="empty-state" id="savedEmpty">กดรูปหัวใจบนสินค้าที่สนใจ เพื่อบันทึกไว้ที่นี่</div>

            <div class="section-heading personal-history-heading"><div><h2>ประวัติการเสนอราคาของคุณ</h2><p>ติดตามสถานะว่าคุณกำลังนำหรือมีผู้เสนอสูงกว่า</p></div></div>
            <div class="table-wrap">
                <table class="data-table">
                    <thead><tr><th>รายการสินค้า</th><th>หมวดหมู่</th><th>ราคาที่คุณเสนอ</th><th>ราคาสูงสุดปัจจุบัน</th><th>สถานะ</th><th>เวลา</th></tr></thead>
                    <!-- แถวประวัติการบิดทั้งหมดของผู้ใช้ เติมจาก data.bidHistory -->
                    <tbody id="bidHistoryRows"><tr class="empty-row"><td colspan="6">คุณยังไม่มีประวัติการเสนอราคา</td></tr></tbody>
                </table>
            </div>
        </section>

        <!-- ==================== BUYER: PAYMENTS, MEETUPS & WON HISTORY ==================== -->
        <!-- 🔗 [จุดเชื่อมต่อ หน้าบ้าน <-> หลังบ้าน] หน้าชำระเงิน นัดรับ และประวัติสินค้าที่ชนะประมูล
             HTTP Method & Route:
               - GET /api/buyer/dashboard -> Controllers/AuctionsController.cs (ดึง data.orders และ data.paymentConfig)
               - POST /api/buyer/orders/{id}/pay (ส่ง FormData พร้อมวิธีชำระและไฟล์สลิปจาก Modal openCheckoutModal()) -> Controllers/AuctionsController.cs
               - POST /api/buyer/orders/{id}/confirm-received (กดปุ่มยืนยันรับของใน #buyerOrdersRows) -> Controllers/AuctionsController.cs
               - POST /api/chat/start (ปุ่มแชทผู้ขาย) -> Controllers/ChatController.cs -->
        <section class="view-panel" id="view-payments">
            <div class="page-heading">
                <p class="eyebrow"><span class="eyebrow-line"></span> SECURE CHECKOUT & MEETUP</p>
                <h1>ชำระเงิน นัดรับ และประวัติที่ประมูลได้</h1>
                <p class="intro">ตรวจสอบส่วนลดหมวดเดียวกัน ชำระเงิน ติดตามนัดรับ และยืนยันรับสินค้า</p>
            </div>

            <div class="section-heading"><div><h2>รายการรอชำระเงิน</h2><p>รับส่วนลดอัตโนมัติเมื่อชนะสินค้าในหมวดหมู่เดียวกัน</p></div></div>
            <!-- การ์ดรายการที่ยังค้างชำระ (Unpaid) กดปุ่มเพื่อเปิด Modal เลือกชำระผ่าน QR ระบบกลาง หรือจ่ายตรงผู้ขาย -->
            <div id="paymentList" class="payment-list"></div>

            <div class="section-heading personal-history-heading"><div><h2>ประวัติสินค้าที่ประมูลได้ & การนัดรับ</h2><p>ตรวจสอบวันเวลานัดรับและกดยืนยันเมื่อได้รับของครบถ้วน</p></div></div>
            <div class="table-wrap">
                <table class="data-table">
                    <thead><tr><th>รหัส / สินค้า</th><th>ผู้ขาย</th><th>ยอดสุทธิ</th><th>สถานะชำระเงิน</th><th>กำหนดนัดรับ</th><th>การดำเนินการ</th></tr></thead>
                    <!-- ตารางคำสั่งซื้อทั้งหมดที่ผู้ซื้อชนะประมูล เติมจาก data.orders -->
                    <tbody id="buyerOrdersRows"><tr class="empty-row"><td colspan="6">ยังไม่มีประวัติสินค้าที่ประมูลได้</td></tr></tbody>
                </table>
            </div>

            <!-- กล่องอธิบายระบบชำระเงินแบบไฮบริด 2 รูปแบบ (Escrow vs Direct) -->
            <div class="payment-assurance">
                <span>✓</span>
                <div><strong>เลือกชำระได้ 2 รูปแบบอย่างมั่นใจ</strong><p>1) <strong>QR ระบบกลาง (แบบ Shopee):</strong> โอนเข้าบัญชีกลางแนบสลิปให้ฝ่ายการเงินตรวจ เงินจะถูกคุ้มครองจนกว่าคุณจะยืนยันรับของ · 2) <strong>จ่ายตรงให้ผู้ขาย:</strong> โอนหรือจ่ายสดตอนนัดรับแล้วให้ผู้ขายกดยืนยัน</p></div>
            </div>
        </section>

        <!-- ==================== BUYER: APPLY TO BE SELLER ==================== -->
        <!-- 🔗 [จุดเชื่อมต่อ หน้าบ้าน <-> หลังบ้าน] หน้าสมัครอัปเกรดบัญชีผู้ซื้อเป็นผู้ขาย
             HTTP Method & Route: POST /api/seller/apply -> Controllers/SellerController.cs
             ข้อมูลที่ส่ง: JSON { shopName, phone, bankAccount, sellerBio } จากฟอร์ม #buyerApplySellerForm
             ข้อมูลที่รับ: JSON ข้อความยืนยันและข้อมูล user ล่าสุด (สถานะ Pending รอ Admin อนุมัติ) -->
        <section class="view-panel" id="view-apply-seller">
            <div class="page-heading">
                <p class="eyebrow"><span class="eyebrow-line"></span> BECOME A SELLER</p>
                <h1>สมัครเป็นผู้ขาย (Seller)</h1>
                <p class="intro">ส่งข้อมูลร้านและบัญชีรับเงินเพื่อให้แอดมินตรวจสอบอนุมัติ</p>
            </div>
            <!-- แบนเนอร์แสดงสถานะใบสมัคร (Pending / Rejected) สร้างโดย renderBuyerApplySeller() ใน site.js -->
            <div id="buyerApplySellerStatus"></div>
            <form class="listing-form narrow-form" id="buyerApplySellerForm">
                <div class="form-card">
                    <div class="form-card-heading"><span class="form-step">01</span><div><h2>ข้อมูลผู้ขาย</h2><p>ใช้สำหรับแสดงหน้าร้านและโอนเงินหลังปิดประมูล</p></div></div>
                    <label class="field-label">ชื่อร้าน / นามแฝงผู้ขาย <span>*</span><input name="shopName" required maxlength="100" placeholder="เช่น กรุของเก่าบ้านพิมพ์ชนก"></label>
                    <div class="field-row">
                        <label class="field-label">เบอร์โทรศัพท์ติดต่อ <span>*</span><input name="phone" required maxlength="30" placeholder="081-234-5678"></label>
                        <label class="field-label">เลขบัญชีรับเงิน <span>*</span><input name="bankAccount" required maxlength="120" placeholder="เช่น กสิกรไทย 123-4-56789-0"></label>
                    </div>
                    <label class="field-label">แนะนำร้านและของที่สะสม <textarea name="sellerBio" rows="3" placeholder="เล่าความถนัดหรือประเภทของสะสมที่นำมาประมูล"></textarea></label>
                    <button class="button button-primary" type="submit">ส่งใบสมัครผู้ขายให้แอดมินอนุมัติ <span>→</span></button>
                </div>
            </form>
        </section>

        <!-- ==================== BUYER & SELLER: MESSAGES ==================== -->
        <!-- 🔗 [จุดเชื่อมต่อ หน้าบ้าน <-> หลังบ้าน] หน้ากล่องข้อความแชทระหว่างผู้ซื้อกับผู้ขาย
             HTTP Method & Route:
               - GET /api/chat/conversations (โหลดรายการห้องแชทลง #conversationItems) -> Controllers/ChatController.cs
               - GET /api/chat/conversations/{id}/messages (โหลดข้อความลง #chatMessages และ #chatHeader) -> Controllers/ChatController.cs
               - POST /api/chat/conversations/{id}/messages (ส่ง JSON { body } จาก #chatForm) -> Controllers/ChatController.cs
               - POST /api/chat/conversations/{id}/dispute (ปุ่มแจ้งข้อพิพาทใน #chatHeader เปิด Modal ส่งเรื่องให้ Admin) -> Controllers/ChatController.cs -->
        <section class="view-panel" id="view-messages">
            <div class="page-heading">
                <p class="eyebrow"><span class="eyebrow-line"></span> TALK & MEET</p>
                <h1>กล่องข้อความ</h1>
                <p class="intro">คุยรายละเอียดสินค้าและนัดรับโดยตรง หากพบปัญหาสามารถแจ้งข้อพิพาทให้แอดมินตรวจสอบได้</p>
            </div>
            <div class="chat-layout">
                <!-- แถบซ้าย: ช่องค้นหาบทสนทนา + รายชื่อห้องแชททั้งหมด -->
                <aside class="conversation-list" id="conversationListPanel">
                    <div class="conversation-search"><span>⌕</span><input id="convSearchInput" type="search" placeholder="ค้นหาบทสนทนา..."></div>
                    <div id="conversationItems"></div>
                </aside>
                <!-- แถบขวา: หัวข้อห้องแชท, ประวัติข้อความ และฟอร์มส่งข้อความ -->
                <div class="chat-window">
                    <div class="chat-header" id="chatHeader">
                        <span class="chat-avatar">?</span>
                        <span><strong>เลือกบทสนทนา</strong><small>คลิกห้องแชททางซ้ายเพื่อดูข้อความ</small></span>
                    </div>
                    <div class="chat-messages" id="chatMessages">
                        <div class="empty-state">เลือกห้องแชทเพื่อเริ่มต้นสนทนา</div>
                    </div>
                    <!-- ฟอร์มพิมพ์ส่งข้อความ (ปลดล็อก disabled เมื่อเลือกห้องแชทแล้ว) -->
                    <form class="chat-compose" id="chatForm">
                        <input id="chatInput" placeholder="พิมพ์ข้อความ..." autocomplete="off" aria-label="พิมพ์ข้อความ" disabled>
                        <button type="submit" id="chatSendBtn" aria-label="ส่งข้อความ" disabled>↑</button>
                    </form>
                </div>
            </div>
        </section>

        <!-- ==================== SELLER: LISTINGS & APPLICATION ==================== -->
        <!-- 🔗 [จุดเชื่อมต่อ หน้าบ้าน <-> หลังบ้าน] พื้นที่ผู้ขาย: ลงขายสินค้าและจัดการสินค้าของฉัน
             HTTP Method & Route:
               - GET /api/seller/dashboard (ดึงสถานะผู้ขาย, รายการสินค้า และสรุปยอด) -> Controllers/SellerController.cs
               - POST /api/seller/apply (ฟอร์มส่งใบสมัครใหม่ #sellerReapplyForm เมื่อถูกปฏิเสธ) -> Controllers/SellerController.cs
               - POST /api/seller/upload-image (อัปโหลดรูปผ่าน FormData จาก #listingImageFile) -> Controllers/SellerController.cs
               - POST /api/seller/listings (ส่ง JSON สร้างรายการประมูลใหม่จาก #listingForm) -> Controllers/SellerController.cs
               - PUT /api/seller/listings/{id} และ DELETE /api/seller/listings/{id} (ปุ่มแก้ไข/ยกเลิกใน #sellerRows) -> Controllers/SellerController.cs -->
        <section class="view-panel" id="view-sell">
            <div class="page-heading">
                <p class="eyebrow"><span class="eyebrow-line"></span> SELLER WORKSPACE</p>
                <h1>ลงขายสินค้า & สินค้าของฉัน</h1>
                <p class="intro">ส่งสินค้าเข้าประมูล ติดตามสถานะการอนุมัติ และดูประวัติการเสนอราคาของสินค้าตัวเอง</p>
            </div>

            <!-- แบนเนอร์แจ้งสถานะการอนุมัติผู้ขาย (Approved / Pending / Rejected) เติมโดย loadSellerDashboard() -->
            <div id="sellerApprovalBanner"></div>

            <!-- กล่องฟอร์มยื่นใบสมัครผู้ขายอีกครั้ง (จะแสดงเฉพาะกรณี sellerStatus === "Rejected") -->
            <div id="sellerReapplyBox" class="hidden">
                <form class="listing-form narrow-form" id="sellerReapplyForm">
                    <div class="form-card">
                        <div class="form-card-heading"><span class="form-step">!</span><div><h2>ข้อมูลใบสมัครผู้ขาย</h2><p>แก้ไขและส่งให้แอดมินตรวจสอบอีกครั้ง</p></div></div>
                        <label class="field-label">ชื่อร้าน <span>*</span><input name="shopName" required maxlength="100"></label>
                        <div class="field-row">
                            <label class="field-label">เบอร์โทรศัพท์ <span>*</span><input name="phone" required maxlength="30"></label>
                            <label class="field-label">บัญชีรับเงิน <span>*</span><input name="bankAccount" required maxlength="120"></label>
                        </div>
                        <label class="field-label">รายละเอียดร้าน <textarea name="sellerBio" rows="3"></textarea></label>
                        <button class="button button-primary" type="submit">บันทึกและส่งใบสมัครอีกครั้ง</button>
                    </div>
                </form>
            </div>

            <!-- โครงสร้างฟอร์มลงขายสินค้า (แสดงเมื่อผู้ขายได้รับการอนุมัติ Approved แล้ว) -->
            <div class="form-layout" id="sellerListingFormWrap">
                <form class="listing-form" id="listingForm">
                    <!-- ขั้นตอน 01: กรอกข้อมูลรายละเอียดสินค้าและอัปโหลดภาพ -->
                    <div class="form-card">
                        <div class="form-card-heading"><span class="form-step">01</span><div><h2>รายละเอียดสินค้า</h2><p>เล่าเรื่องของสะสมชิ้นนี้ให้ผู้ประมูลรู้จัก</p></div></div>
                        <label class="field-label">ชื่อสินค้า <span>*</span><input name="name" required maxlength="100" placeholder="เช่น มีดครัวญี่ปุ่นตีมือ รุ่นปี 1970"></label>
                        <div class="field-row">
                            <!-- ตัวเลือกหมวดหมู่ #listingCategorySelect เติมจาก cachedCategories (GET /api/auctions) -->
                            <label class="field-label">หมวดหมู่ <span>*</span><select name="categoryId" id="listingCategorySelect" required></select></label>
                            <label class="field-label">สภาพสินค้า <span>*</span><select name="condition" required><option value="">เลือกสภาพ</option><option>ดีมาก — เก็บสะสม</option><option>ดี — มีร่องรอยตามอายุ</option><option>ผ่านการใช้งาน</option></select></label>
                        </div>
                        <label class="field-label">รายละเอียดและประวัติ <span>*</span><textarea name="description" rows="4" required placeholder="ที่มา อายุโดยประมาณ วัสดุ และตำหนิ (ถ้ามี)"></textarea></label>
                        <div class="field-row">
                            <!-- เมื่อเลือกไฟล์ใน #listingImageFile จะอัปโหลดทันทีไปยัง POST /api/seller/upload-image แล้วนำ URL มาใส่ใน #listingImageUrlInput -->
                            <label class="field-label">อัปโหลดรูปสินค้าจากเครื่อง
                                <input type="file" id="listingImageFile" accept=".jpg,.jpeg,.png,.webp,image/*">
                                <small class="field-hint">รองรับ .jpg/.png/.webp ไม่เกิน 5 MB</small>
                            </label>
                            <label class="field-label">หรือวางลิงก์รูปภาพสินค้า
                                <input name="imageUrl" id="listingImageUrlInput" type="text" placeholder="https://... หรืออัปโหลดด้านซ้าย">
                                <small class="field-hint">เว้นว่างได้ ระบบจะใช้ภาพเริ่มต้นให้</small>
                            </label>
                        </div>
                        <!-- พื้นที่พรีวิวรูปสินค้าที่เพิ่งอัปโหลด -->
                        <div class="slip-preview-wrap hidden" id="listingImagePreviewWrap" style="margin-bottom:12px;">
                            <img id="listingImagePreview" class="slip-preview-img" alt="ตัวอย่างรูปสินค้า">
                        </div>
                    </div>
                    <!-- ขั้นตอน 02: ตั้งค่าราคาเริ่มต้น, ขั้นต่ำการบิด และเวลาเริ่ม-สิ้นสุดประมูล -->
                    <div class="form-card">
                        <div class="form-card-heading"><span class="form-step">02</span><div><h2>ตั้งค่าการประมูล</h2><p>กำหนดราคาเริ่มต้น ขั้นต่ำ และช่วงเวลาที่เปิดประมูล</p></div></div>
                        <div class="field-row">
                            <label class="field-label">ราคาเริ่มต้น (บาท) <span>*</span><input name="startPrice" type="number" min="1" step="1" required placeholder="เช่น 500"></label>
                            <!-- ค่า min ของ #listingMinIncrement และข้อความ #sellerMinBidHint ถูกกำหนดตามกติกาของฝ่าย Finance -->
                            <label class="field-label">ขั้นต่ำต่อครั้ง (บาท) <input name="minIncrement" id="listingMinIncrement" type="number" min="1" step="1" value="50"><small class="field-hint" id="sellerMinBidHint">ขั้นต่ำตามกติกาฝ่ายการเงิน</small></label>
                        </div>
                        <div class="field-row">
                            <!-- ค่าเริ่มต้นวันเวลาถูกกำหนดโดย initListingDates() ใน site.js และแปลงเป็น UTC ISO ก่อนส่ง API -->
                            <label class="field-label">เริ่มประมูล <span>*</span><input name="startAt" type="datetime-local" required></label>
                            <label class="field-label">สิ้นสุดประมูล <span>*</span><input name="endAt" type="datetime-local" required></label>
                        </div>
                        <button class="button button-primary submit-listing" type="submit">ส่งให้แอดมินตรวจสอบ <span>→</span></button>
                    </div>
                </form>
                <!-- แถบคำแนะนำและขั้นตอนการขายด้านขวาของฟอร์ม -->
                <aside class="seller-aside">
                    <div class="seller-tip">
                        <span class="tip-icon">✦</span>
                        <h3>เคล็ดลับผู้ขาย</h3>
                        <ul>
                            <li>ระบุอายุ ที่มา และตำหนิให้ชัดเจนเพื่อลดข้อพิพาท</li>
                            <li>ตั้งเวลาเริ่ม-จบให้เหมาะสมกับผู้ประมูล</li>
                            <li>หลังผู้ซื้อชำระเงิน กำหนดนัดรับและกดยืนยันส่งมอบ</li>
                        </ul>
                    </div>
                    <div class="seller-status">
                        <strong>ขั้นตอนการขาย</strong>
                        <div><i class="step-done">1</i><span>ลงสินค้า รอแอดมินอนุมัติ</span></div>
                        <div><i>2</i><span>เปิดประมูลและแชทตอบผู้ซื้อ</span></div>
                        <div><i>3</i><span>นัดรับ & ยืนยันส่งมอบ</span></div>
                        <div><i>4</i><span>ฝ่ายการเงินปล่อยยอดสุทธิ</span></div>
                    </div>
                </aside>
            </div>

            <!-- ตารางรายการสินค้าทั้งหมดของผู้ขาย พร้อมปุ่มดูประวัติบิด, แก้ไข และยกเลิก -->
            <div class="section-heading personal-history-heading"><div><h2>สินค้าของฉัน</h2><p>ตรวจสอบสถานะอนุมัติ เหตุผลที่ถูกปฏิเสธ และประวัติการเสนอราคาของแต่ละชิ้น</p></div></div>
            <div class="table-wrap">
                <table class="data-table">
                    <thead><tr><th>สินค้า</th><th>ราคาเริ่ม / ปัจจุบัน</th><th>ช่วงเวลาประมูล</th><th>สถานะ</th><th>ประวัติเสนอราคา</th></tr></thead>
                    <tbody id="sellerRows"><tr class="empty-row"><td colspan="5">ยังไม่มีสินค้าที่ลงขาย</td></tr></tbody>
                </table>
            </div>
        </section>

        <!-- ==================== SELLER: MEETUPS & SALES / PAYOUTS ==================== -->
        <!-- 🔗 [จุดเชื่อมต่อ หน้าบ้าน <-> หลังบ้าน] หน้านัดรับ ยอดขาย และสถานะรับเงินของผู้ขาย
             HTTP Method & Route:
               - GET /api/seller/dashboard (ดึง data.summary ลง #sellerFinanceStats และ data.orders ลง #sellerOrdersRows) -> Controllers/SellerController.cs
               - POST /api/seller/orders/{id}/verify-payment (ยืนยัน/ปฏิเสธการจ่ายตรงจากผู้ซื้อ) -> Controllers/SellerController.cs
               - POST /api/seller/orders/{id}/meetup (บันทึกวันเวลาและสถานที่นัดรับผ่าน Modal) -> Controllers/SellerController.cs
               - POST /api/seller/orders/{id}/deliver (ยืนยันว่าส่งมอบสินค้าแล้ว) -> Controllers/SellerController.cs -->
        <section class="view-panel" id="view-seller-orders">
            <div class="page-heading">
                <p class="eyebrow"><span class="eyebrow-line"></span> SALES & MEETUP</p>
                <h1>นัดรับ ยอดขาย และสถานะการจ่ายเงิน</h1>
                <p class="intro">กำหนดสถานที่นัดรับ ยืนยันการส่งมอบ และติดตามยอดโอนสุทธิจากฝ่ายการเงิน</p>
