@* ============================================================================
   ไฟล์: Views/_ViewStart.cshtml
   บทบาท: ฝั่งหน้าบ้าน (Frontend — Razor View Configuration)
   หน้าที่โดยรวม: ทำงานอัตโนมัติก่อนการเรนเดอร์ (Render) หน้า View ทุกไฟล์ในโฟลเดอร์ Views/
                 เพื่อกำหนด Layout หลัก (Master Page) ให้ทุกหน้าใช้งานร่วมกัน
   การเชื่อมต่อ: เชื่อมไปยัง Views/Shared/_Layout.cshtml เป็นโครงสร้าง HTML หลักของเว็บ
   ============================================================================ *@
@{
    // กำหนดให้ View ทุกหน้าใช้ไฟล์ Views/Shared/_Layout.cshtml เป็นเทมเพลตหลัก
    Layout = "_Layout";
}
